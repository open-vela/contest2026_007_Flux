  background-color: #1a2c40;
  color: #6fb2ff;
}

/* ========== 主内容区 ========== */
.content-area {
  width: 320px;
  height: 195px;
  padding: 8px 15px;
  flex-direction: column;
}

.main-scroll {
  height: 179px;
  flex-direction: column;
}

.main-panel-light {
  background: linear-gradient(180deg, #e8f4fd 0%, #f2f5f6 100%);
}

.main-panel-dark {
  background: linear-gradient(180deg, #0a1628 0%, #202020 100%);
}

/* ========== 时钟区 ========== */
.hero-clock {
  height: 65px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.hero-time {
  font-size: 32px;
  font-weight: bold;
  line-height: 40px;
}

.hero-date {
  margin-top: 3px;
  font-size: 14px;
  line-height: 18px;
}

/* ========== 天气摘要 ========== */
.weather-bar {
  height: 30px;
  margin-top: 8px;
  padding: 0 12px;
  border-radius: 5px;
  flex-direction: row;
  align-items: center;
}

.weather-text {
  font-size: 16px;
  font-weight: bold;
}

/* ========== 通用卡片 ========== */
.section-card {
  margin-top: 8px;
  padding: 12px 12px;
  border-radius: 5px;
  flex-direction: column;
}

.section-label {
  font-size: 11px;
  margin-bottom: 6px;
}

.card-light {
  background-color: #ffffff;
}

.card-dark {
  background-color: #171717;
}

/* ========== 今日新闻 ========== */
.news-title {
  font-size: 16px;
  font-weight: bold;
  line-height: 20px;
}

.news-desc {
  margin-top: 4px;
  font-size: 14px;
  line-height: 18px;
}

.news-meta {
  margin-top: 5px;
  font-size: 11px;
}

/* ========== 历史上的今天 ========== */
.history-item {
  margin-bottom: 6px;
  flex-direction: row;
  align-items: flex-start;
}

.history-year {
  width: 65px;
  font-size: 11px;
  font-weight: bold;
  margin-top: 2px;
}

.history-content {
  width: 225px;
  flex-direction: column;
}

.history-title {
  font-size: 14px;
  font-weight: bold;
  line-height: 18px;
}

.history-desc {
  margin-top: 3px;
  font-size: 11px;
  line-height: 14px;
}

/* ========== 文字颜色 ========== */
.text-light {
  color: #172026;
}

.text-light-sub {
  color: #627279;
}

.text-dark {
  color: #edf4f4;
}

.text-dark-sub {
  color: #aebdc2;
}

.btn-light {
  background-color: #e8eef0;
  color: #172026;
}

.btn-dark {
  background-color: #262626;
  color: #edf4f4;
}
</style>
