  flex-direction: column;
  justify-content: center;
}

.brand-en {
  font-size: 8px;
  color: #0074ff;
  font-weight: bold;
}

.brand-title {
  margin-top: 2px;
  font-size: 13px;
  font-weight: bold;
}

.nav-buttons {
  flex-direction: row;
  align-items: center;
}

.nav-button {
  width: 48px;
  height: 28px;
  margin-left: 5px;
  border-radius: 4px;
  background-color: #e8eef0;
  color: #172026;
  font-size: 12px;
  font-weight: bold;
}

.nav-button-active {
  background-color: #0074ff;
  color: #ffffff;
}

.theme-button {
  width: 48px;
  height: 28px;
  margin-left: 5px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: bold;
}

.theme-btn-light {
  background-color: #e6f1ff;
  color: #0057bf;
}

